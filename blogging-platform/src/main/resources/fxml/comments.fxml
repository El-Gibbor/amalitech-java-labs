<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.CommentController"
      spacing="8" prefWidth="280">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <Label text="Comments" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

    <TableView fx:id="commentsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="commentIdColumn" text="ID" prefWidth="40" />
            <TableColumn fx:id="commentUserIdColumn" text="User" prefWidth="50" />
            <TableColumn fx:id="commentContentColumn" text="Comment" prefWidth="170" />
        </columns>
    </TableView>

    <TextArea fx:id="commentContentField" promptText="Write a comment..." prefRowCount="3" />

    <HBox spacing="8">
        <Button fx:id="addCommentButton" text="Add" onAction="#onAddComment" />
        <Button fx:id="updateCommentButton" text="Update" onAction="#onUpdateComment" />
        <Button fx:id="deleteCommentButton" text="Delete" onAction="#onDeleteComment" />
    </HBox>

    <Label fx:id="commentStatusLabel" textFill="#b00020" wrapText="true" />
</VBox>
