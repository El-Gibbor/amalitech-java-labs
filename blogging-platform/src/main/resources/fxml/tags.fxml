<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.TagController"
      spacing="8" prefWidth="260">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <Label text="Tags" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

    <TableView fx:id="allTagsTable" prefHeight="160">
        <columns>
            <TableColumn fx:id="tagIdColumn" text="ID" prefWidth="40" />
            <TableColumn fx:id="tagNameColumn" text="Name" prefWidth="170" />
        </columns>
    </TableView>

    <HBox spacing="8">
        <TextField fx:id="newTagNameField" promptText="New tag name" HBox.hgrow="ALWAYS" />
        <Button fx:id="createTagButton" text="Create" onAction="#onCreateTag" />
    </HBox>
    <Button fx:id="deleteTagButton" text="Delete Selected Tag" onAction="#onDeleteTag" />

    <Separator />

    <Label text="Tags on this post" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

    <TableView fx:id="postTagsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="postTagNameColumn" text="Name" prefWidth="210" />
        </columns>
    </TableView>

    <HBox spacing="8">
        <ComboBox fx:id="availableTagsComboBox" HBox.hgrow="ALWAYS" />
        <Button fx:id="assignTagButton" text="Assign" onAction="#onAssignTag" />
    </HBox>
    <Button fx:id="removeTagButton" text="Remove from Post" onAction="#onRemoveTag" />

    <Label fx:id="statusLabel" textFill="#b00020" wrapText="true" />
</VBox>
