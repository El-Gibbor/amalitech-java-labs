<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ReviewController"
      spacing="8" prefWidth="280">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <Label text="Reviews" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
    <Label fx:id="averageRatingLabel" />

    <TableView fx:id="reviewsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="reviewIdColumn" text="ID" prefWidth="40" />
            <TableColumn fx:id="reviewUserIdColumn" text="User" prefWidth="50" />
            <TableColumn fx:id="reviewRatingColumn" text="Rating" prefWidth="55" />
            <TableColumn fx:id="reviewTextColumn" text="Review" prefWidth="140" />
        </columns>
    </TableView>

    <HBox spacing="8">
        <Label text="Rating:" />
        <ComboBox fx:id="ratingComboBox" />
    </HBox>
    <TextArea fx:id="reviewTextField" promptText="Write a review (optional)..." prefRowCount="3" />

    <HBox spacing="8">
        <Button fx:id="addReviewButton" text="Add" onAction="#onAddReview" />
        <Button fx:id="updateReviewButton" text="Update" onAction="#onUpdateReview" />
        <Button fx:id="deleteReviewButton" text="Delete" onAction="#onDeleteReview" />
    </HBox>

    <Label fx:id="reviewStatusLabel" textFill="#b00020" wrapText="true" />
</VBox>
